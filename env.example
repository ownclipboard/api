NODE_ENV=development
SECRET_KEY="!my-super-secret-key!"

#TZ="YOUR_DESIRED_TIME_ZONE"

APP_PORT=3003
APP_DOMAIN=localhost
APP_PROTOCOL=http

APP_PREVIEW=false
APP_PREVIEW_URL=clip.ngrok.io

# MONGODB CONFIG
DATABASE_SERVER="mongodb://127.0.0.1:27017"
DATABASE_NAME="ownclipboard"
DATABASE_PASSWORD="password"

# NOWPAYMENTS CONFIG
NOW_PAYMENTS_API_KEY="your-nowpayments-api-key"
NOW_PAYMENTS_IPN_SECRET="your-nowpayments-ipn-secret"
# Set to true to use https://api-sandbox.nowpayments.io with a sandbox api key
NOW_PAYMENTS_SANDBOX=false

# Public url of this api, used to build the NowPayments IPN callback url.
WEBHOOK_URL="http://localhost:3003"
# Url of the client app, users are sent back here after payment.
FRONTEND_URL="http://localhost:3000"

# DEFAULT OWNS3 STORAGE (optional)
# Offered to users who do not connect their own owns3 server. Leave empty to disable.
OWNS3_DEFAULT_ENDPOINT="https://owns3.ownclipboard.com"
OWNS3_DEFAULT_API_KEY="your-owns3-app-api-key"
